        <mxCell id="EPepReuN3eNijD8TEbl1-3" parent="EPepReuN3eNijD8TEbl1-2" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Times New Roman;fontSize=16;" value="&lt;b&gt;&amp;nbsp; （ Graph Attention Network ）&lt;/b&gt;为了考虑邻居节点在学习空间依赖关系中的重要性，GAT&amp;nbsp; 将注意力机制集成到节点聚合操作中。 α&lt;sub&gt;vu&lt;/sub&gt; 表示邻居节点 u 对目标节点 v 的注意力得分，W 是与每个节点线性变换相关的权重矩阵，a 是注意力输出的权重参数。&amp;nbsp;" vertex="1">
          <mxGeometry height="101" width="531" x="7" y="19" as="geometry" />
        </mxCell>
        <mxCell id="EPepReuN3eNijD8TEbl1-6" parent="EPepReuN3eNijD8TEbl1-2" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="138" width="448.07" x="37" y="107" as="geometry" />
        </mxCell>
        <mxCell id="EPepReuN3eNijD8TEbl1-9" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Times New Roman;fontSize=16;" value="&lt;div style=&quot;text-align: left;&quot;&gt;TSAN 因果时间卷积层&lt;/div&gt;" vertex="1">
          <mxGeometry height="206" width="541" x="28" y="2134" as="geometry">
            <mxRectangle height="29" width="158" x="-617" y="709" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="EPepReuN3eNijD8TEbl1-10" parent="EPepReuN3eNijD8TEbl1-9" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;fontFamily=Times New Roman;fontSize=16;" value="&lt;b&gt;&amp;nbsp; （Temporal Self-Attention Networks）&lt;/b&gt;能够显式地建模时间数据的因果特性。这是通过移除未来时间步与过去时间步之间的连接来实现的，从而消除了未来时间步的数据泄露到过去时间步的可能性。&amp;nbsp;" vertex="1">
          <mxGeometry height="91" width="531" x="7" y="19" as="geometry" />
        </mxCell>
        <mxCell id="EPepReuN3eNijD8TEbl1-13" parent="EPepReuN3eNijD8TEbl1-9" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="82" width="477.66" x="15" y="110" as="geometry" />
        </mxCell>
        <mxCell id="EPepReuN3eNijD8TEbl1-14" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="490" width="632.22" x="-662" y="1843" as="geometry" />
        </mxCell>
        <mxCell id="EPepReuN3eNijD8TEbl1-15" parent="1" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;labelPosition=left;verticalLabelPosition=middle;align=right;verticalAlign=middle;strokeWidth=2;fontFamily=Times New Roman;fontSize=16;" value="" vertex="1">
          <mxGeometry height="150" width="20" x="-758" y="2405" as="geometry" />
        </mxCell>
        <mxCell id="EPepReuN3eNijD8TEbl1-16" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;autosize=1;resizable=0;fontFamily=Times New Roman;fontSize=16;" value="&lt;b&gt;3. TPM&lt;/b&gt;" vertex="1">
          <mxGeometry height="31" width="69" x="-924" y="2464.5" as="geometry" />
        </mxCell>
        <mxCell id="EPepReuN3eNijD8TEbl1-21" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;span style=&quot;font-family: &amp;quot;Times New Roman&amp;quot;; font-size: 16px; font-weight: 700; text-align: left;&quot;&gt;预测输出层TPM模块&lt;/span&gt;" vertex="1">
          <mxGeometry height="90" width="308" x="-647" y="2419" as="geometry" />
        </mxCell>
        <mxCell id="a0mC8izihnYD4kPPHs40-4" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(76, 79, 105); font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: pre; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size: 18px;&quot;&gt;输入: (特征 X, 邻接矩阵 A)&lt;br&gt;     A 固定不变&lt;br&gt;空间卷积: H = GCN(X, A)     # 同一张图在所有时间步上用&lt;br&gt;时间卷积: Y = TCN(H)        # 每个节点各自做时序&lt;/font&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="99" width="472" x="1134" y="609" as="geometry" />
        </mxCell>
        <mxCell id="a0mC8izihnYD4kPPHs40-12" parent="1" style="text;whiteSpace=wrap;html=1;" value="&lt;span style=&quot;color: rgb(76, 79, 105); font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: pre; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size: 18px;&quot;&gt;输入: 图快照序列 [G₁, G₂, ..., G_T]&lt;br&gt;       每个 G_t 有自己的 A_t&lt;br&gt;空间卷积: H_t = GCN(X_t, A_t)   # 每步图不同&lt;br&gt;时间融合: Y = TemporalAgg([H₁,...,H_T])  # 跨时间步聚合&lt;/font&gt;&lt;/span&gt;" vertex="1">
